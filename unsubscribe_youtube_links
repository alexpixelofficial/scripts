(async function ultimateUnsubscribe() {
    console.log('🚀 ЗАПУСК МАССОВОЙ ОТПИСКИ (блочная версия)');

    // ---------- Настройки ----------
    const CHANNELS_PER_BLOCK = 3;       // сколько каналов отписывать за 1 блок
    const PAUSE_BETWEEN_UNSUB = 1200;   // мс между отписками
    const SCROLL_WAIT = 2000;           // мс ожидания после каждой прокрутки
    const MAX_SCROLL_ATTEMPTS = 30;     // макс. прокруток за один блок
    const MIN_CHANNELS_TO_START = 3;    // минимальное число каналов для старта
    
    // ---------- Вспомогательные функции ----------
    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    function waitForElement(selector, timeout = 8000) {
        return new Promise((resolve) => {
            const start = Date.now();
            const check = () => {
                const el = document.querySelector(selector);
                if (el) resolve(el);
                else if (Date.now() - start > timeout) resolve(null);
                else setTimeout(check, 300);
            };
            check();
        });
    }

    function clickElement(element, description = '') {
        if (!element) return;
        element.scrollIntoView({ block: 'center' });
        setTimeout(() => {
            element.click();
            element.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
        }, 200);
        if (description) console.log(`   🖱️ ${description}`);
    }

    function getChannelName(channel) {
        const selectors = ['#channel-name a', '#text-container a', 'ytd-channel-name a', 'a#channel-name'];
        for (const sel of selectors) {
            const el = channel.querySelector(sel);
            if (el) {
                const text = el.textContent.trim();
                if (text) return text;
            }
        }
        const link = channel.querySelector('a[href*="/@"]');
        if (link && link.getAttribute('aria-label')) {
            const aria = link.getAttribute('aria-label');
            const match = aria.match(/канал\s+(.+?)(?:$|,)/i);
            if (match) return match[1].trim();
        }
        return 'Неизвестный канал';
    }

    function getTotalSubscribed() {
        const allChannels = document.querySelectorAll('ytd-channel-renderer');
        let count = 0;
        for (const ch of allChannels) {
            if (ch.querySelector('ytd-subscribe-button-renderer[subscribed]')) {
                count++;
            }
        }
        return count;
    }

    async function unsubscribeOne(channel) {
        const name = getChannelName(channel);
        console.log(`   🔹 ${name}`);

        const subBtn = channel.querySelector('ytd-subscribe-button-renderer[subscribed] button');
        if (!subBtn) {
            console.log('   ⏭️ нет кнопки подписки');
            return false;
        }

        clickElement(subBtn, 'кнопка "Подписан"');
        await sleep(800);

        let dialog = await waitForElement('yt-confirm-dialog-renderer', 6000);
        if (!dialog) {
            console.log('   ⏳ диалог не появился, ищем меню...');
            const menu = await waitForElement('tp-yt-paper-listbox, paper-menu, ytd-menu-popup-renderer', 4000);
            if (menu) {
                const items = menu.querySelectorAll('ytd-menu-service-item-renderer, paper-item, tp-yt-paper-item, div[role="menuitem"]');
                let found = false;
                for (const item of items) {
                    const text = item.textContent.trim();
                    if (text.includes('Отписаться') || text.includes('Unsubscribe')) {
                        clickElement(item, 'пункт "Отписаться"');
                        found = true;
                        break;
                    }
                }
                if (found) {
                    await sleep(800);
                    dialog = await waitForElement('yt-confirm-dialog-renderer', 6000);
                    if (!dialog) {
                        console.log('   ❌ диалог после меню не появился');
                        return false;
                    }
                } else {
                    console.log('   ❌ пункт "Отписаться" не найден');
                    return false;
                }
            } else {
                console.log('   ❌ ни диалог, ни меню не найдены');
                return false;
            }
        }

        console.log('   🔍 ищем кнопку подтверждения...');
        let confirmBtn = null;
        const allButtons = dialog.querySelectorAll('button');
        for (const btn of allButtons) {
            const aria = btn.getAttribute('aria-label') || '';
            const text = btn.textContent.trim();
            if (aria.includes('Отказаться от подписки') || aria.includes('Unsubscribe') ||
                text.includes('Отказаться от подписки') || text.includes('Unsubscribe')) {
                confirmBtn = btn;
                break;
            }
        }
        if (!confirmBtn) {
            const wrapper = dialog.querySelector('#confirm-button');
            if (wrapper) {
                confirmBtn = wrapper.querySelector('button') || wrapper;
            }
        }
        if (!confirmBtn) {
            console.log('   ❌ кнопка подтверждения не найдена');
            return false;
        }

        clickElement(confirmBtn, 'синяя кнопка "Отказаться"');
        await sleep(1000);
        console.log('   ✅ отписан');
        return true;
    }

    async function scrollToLoadChannels() {
        console.log('   🔄 Загрузка каналов...');
        let lastHeight = 0;
        let noChangeCount = 0;
        let scrollAttempts = 0;

        while (scrollAttempts < MAX_SCROLL_ATTEMPTS) {
            window.scrollTo(0, document.documentElement.scrollHeight);
            await sleep(SCROLL_WAIT);

            const newHeight = document.documentElement.scrollHeight;
            if (newHeight === lastHeight) {
                noChangeCount++;
                if (noChangeCount >= 3) {
                    break;
                }
            } else {
                noChangeCount = 0;
                lastHeight = newHeight;
            }
            scrollAttempts++;
        }

        await sleep(1000);
        const total = getTotalSubscribed();
        console.log(`   📊 Загружено каналов: ${total}`);
        window.scrollTo(0, 0);
        await sleep(500);
    }

    async function processBlock(blockNumber, channels) {
        console.log(`\n📦 БЛОК #${blockNumber} (${channels.length} каналов)`);
        
        let successCount = 0;
        let failCount = 0;

        for (let i = 0; i < channels.length; i++) {
            const channel = channels[i];
            console.log(`   Канал ${i + 1}/${channels.length}`);
            const ok = await unsubscribeOne(channel);
            if (ok) successCount++; else failCount++;
            await sleep(PAUSE_BETWEEN_UNSUB);
        }

        console.log(`   📊 Блок #${blockNumber}: успешно ${successCount}, ошибок ${failCount}`);
        return { successCount, failCount };
    }

    async function refreshPage() {
        console.log('\n🔄 Перезагрузка страницы для очистки DOM...');
        // Сохраняем URL текущей страницы
        const currentUrl = window.location.href;
        
        // Перезагружаем страницу
        window.location.reload();
        
        // Ждем загрузки страницы
        await new Promise((resolve) => {
            const checkReady = () => {
                if (document.readyState === 'complete') {
                    resolve();
                } else {
                    setTimeout(checkReady, 500);
                }
            };
            checkReady();
        });
        
        // Дополнительная задержка для полной загрузки YouTube
        console.log('   ⏳ Ждем полной загрузки страницы...');
        await sleep(5000);
        
        // Проверяем, что мы на нужной странице
        if (window.location.href !== currentUrl) {
            console.log('   ⚠️ URL изменился, пытаемся вернуться...');
            window.location.href = currentUrl;
            await sleep(5000);
        }
        
        console.log('   ✅ Страница перезагружена');
    }

    // ---------- Основной процесс ----------
    console.log('📌 Начинаем отписку блоками по', CHANNELS_PER_BLOCK, 'канала');

    let totalSuccess = 0;
    let totalFail = 0;
    let blockNumber = 0;
    let hasMoreChannels = true;

    while (hasMoreChannels) {
        blockNumber++;
        
        // Загружаем каналы
        await scrollToLoadChannels();
        
        // Собираем подписанные каналы
        const allChannels = document.querySelectorAll('ytd-channel-renderer');
        const subscribedChannels = [];
        for (const ch of allChannels) {
            if (ch.querySelector('ytd-subscribe-button-renderer[subscribed]')) {
                subscribedChannels.push(ch);
            }
        }

        console.log(`\n📊 Найдено подписанных каналов: ${subscribedChannels.length}`);

        if (subscribedChannels.length === 0) {
            console.log('🎉 Все подписки отписаны!');
            hasMoreChannels = false;
            break;
        }

        // Берем только первые CHANNELS_PER_BLOCK каналов
        const channelsToProcess = subscribedChannels.slice(0, CHANNELS_PER_BLOCK);
        
        // Обрабатываем блок
        const result = await processBlock(blockNumber, channelsToProcess);
        totalSuccess += result.successCount;
        totalFail += result.failCount;

        // Проверяем, остались ли еще подписки
        const remaining = getTotalSubscribed();
        if (remaining === 0) {
            console.log('🎉 Все подписки отписаны!');
            hasMoreChannels = false;
            break;
        }

        // Перезагружаем страницу перед следующим блоком
        if (remaining > 0) {
            console.log(`\n📊 Осталось подписок: ${remaining}`);
            console.log('⏳ Пауза перед следующим блоком...');
            await sleep(3000);
            await refreshPage();
        }
    }

    console.log(`\n📊 ИТОГО: успешно отписано ${totalSuccess}, ошибок ${totalFail}`);
    console.log('✅ СКРИПТ ЗАВЕРШЁН.');
})();
