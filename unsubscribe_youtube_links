(async function ultimateUnsubscribeV4() {
  console.log('🚀 МАССОВАЯ ОТПИСКА v4 — чистит пустые блоки YouTube и догружает до конца');

  const PAUSE_BETWEEN = 1200;
  const MAX_EMPTY_ROUNDS = 6;
  const MAX_ROUNDS = 300;

  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const $  = s => document.querySelector(s);
  const $$ = s => Array.from(document.querySelectorAll(s));

  // статистика сохраняется между F5
  const stats = JSON.parse(sessionStorage.getItem('unsub_stats') || '{"ok":0,"fail":0}');
  if (stats.ok || stats.fail) console.log(`📦 Продолжаем сессию: уже отписано ${stats.ok}, ошибок ${stats.fail}`);

  function click(el, desc = '') {
    if (!el) return;
    el.scrollIntoView({ block: 'center' });
    el.click();
    if (desc) console.log('   🖱️ ' + desc);
  }

  function waitFor(selector, timeout = 6000) {
    return new Promise(res => {
      const t0 = Date.now();
      (function chk() {
        const el = document.querySelector(selector);
        if (el || Date.now() - t0 > timeout) res(el);
        else setTimeout(chk, 250);
      })();
    });
  }

  const channelsInDom = () => $$('ytd-channel-renderer');
  const isSubscribed = ch => {
    const btn = ch.querySelector('ytd-subscribe-button-renderer');
    if (!btn) return false;
    const txt = btn.textContent || '';
    return btn.hasAttribute('subscribed') || /Вы подписаны|Subscribed/.test(txt);
  };
  const getSubscribed = () => channelsInDom().filter(isSubscribed);
  const name = ch => {
    const a = ch.querySelector('#channel-name a, ytd-channel-name a, a[href*="/@"]');
    return a ? a.textContent.trim() : 'канал';
  };

  // 🧹 ЧИСТКА пустых блоков YouTube, которые забивают страницу и ломают скролл
  function cleanEmptyBlocks() {
    let removed = 0;
    // пустые полки
    $$('ytd-shelf-renderer').forEach(el => {
      if (!el.querySelector('ytd-channel-renderer')) { el.remove(); removed++; }
    });
    // пустые сетки и rich-блоки
    $$('ytd-grid-renderer, ytd-rich-section-renderer, ytd-rich-shelf-renderer').forEach(el => {
      if (!el.querySelector('ytd-channel-renderer')) { el.remove(); removed++; }
    });
    // те самые «мёртвые» ytd-item-section-renderer с пустым #contents.
    // ВАЖНО: не удаляем секцию, если внутри есть continuation — это триггер подгрузки!
    $$('ytd-item-section-renderer').forEach(el => {
      const hasCh   = el.querySelector('ytd-channel-renderer');
      const hasCont = el.querySelector('ytd-continuation-item-renderer');
      if (!hasCh && !hasCont) { el.remove(); removed++; }
    });
    if (removed) console.log('🧹 Удалено пустых блоков: ' + removed);
    return removed;
  }

  async function waitSpinner(timeout = 5000) {
    const t0 = Date.now();
    while (Date.now() - t0 < timeout) {
      const sp = $('tp-yt-paper-spinner-lite[active]') || $('tp-yt-paper-spinner-lite[aria-hidden="false"]');
      if (!sp) return;
      await sleep(300);
    }
  }

  // умная подгрузка: скроллим всё, что скроллится + дёргаем continuation
  async function forceLoadMore() {
    const before = channelsInDom().length;
    for (let i = 0; i < 6; i++) {
      cleanEmptyBlocks(); // сначала освобождаем страницу от мёртвых секций
      const cont = $('ytd-continuation-item-renderer');
      if (cont) cont.scrollIntoView({ block: 'center' });
      window.scrollTo(0, document.body.scrollHeight);
      const content = $('#content');
      if (content) content.scrollTop = content.scrollHeight;
      window.dispatchEvent(new Event('scroll'));
      document.dispatchEvent(new Event('scroll'));
      await waitSpinner();
      await sleep(900);
      if (channelsInDom().length > before) return true;
      if (!cont) break; // подгружать больше нечего
    }
    return channelsInDom().length > before;
  }

  async function unsubOne(ch) {
    console.log('🔹 ' + name(ch));
    const btn = ch.querySelector('ytd-subscribe-button-renderer button');
    if (!btn) return false;

    click(btn, '«Вы подписаны»');
    await sleep(700);

    let dialog = await waitFor('yt-confirm-dialog-renderer', 3500);
    if (!dialog) {
      const menu = await waitFor('tp-yt-paper-listbox, ytd-menu-popup-renderer', 2500);
      if (menu) {
        for (const it of menu.querySelectorAll('[role="menuitem"], ytd-menu-service-item-renderer, tp-yt-paper-item')) {
          if (/Отписаться|Unsubscribe/i.test(it.textContent)) { click(it, '«Отписаться»'); break; }
        }
        await sleep(700);
        dialog = await waitFor('yt-confirm-dialog-renderer', 3500);
      }
    }
    if (!dialog) { console.log('   ❌ нет диалога'); return false; }

    const confirmBtn =
      Array.from(dialog.querySelectorAll('button'))
        .find(b => /Отказаться|Отписаться|Unsubscribe/i.test(b.textContent + (b.getAttribute('aria-label') || ''))) ||
      dialog.querySelector('#confirm-button button, #confirm-button');
    if (!confirmBtn) { console.log('   ❌ нет кнопки подтверждения'); return false; }

    click(confirmBtn, 'подтверждение');
    await sleep(900);
    console.log('   ✅ отписан');
    return true;
  }

  // ---------- основной цикл ----------
  let empty = 0, round = 0;

  while (empty < MAX_EMPTY_ROUNDS && round < MAX_ROUNDS) {
    round++;
    cleanEmptyBlocks();

    // YouTube сам показал «подписок нет» — завершаем
    if (round > 1 && $('ytd-message-renderer') && !getSubscribed().length) break;

    const list = getSubscribed();
    console.log(`📊 Раунд ${round}: подписок в DOM: ${list.length}`);

    if (!list.length) {
      empty++;
      console.log(`   ⏳ не найдено, подгружаю (${empty}/${MAX_EMPTY_ROUNDS})...`);
      await forceLoadMore();
      continue;
    }
    empty = 0;

    for (const ch of list) {
      const parentShelf = ch.closest('ytd-shelf-renderer');
      if (await unsubOne(ch)) stats.ok++; else stats.fail++;
      ch.remove();
      if (parentShelf && !parentShelf.querySelector('ytd-channel-renderer')) parentShelf.remove();
      cleanEmptyBlocks();
      await sleep(PAUSE_BETWEEN);
    }

    console.log(`📈 Промежуточно: ✅ ${stats.ok}, ❌ ${stats.fail}`);
    await forceLoadMore();
  }

  cleanEmptyBlocks();
  sessionStorage.setItem('unsub_stats', JSON.stringify(stats));
  console.log(`🎉 ГОТОВО! Всего отписано: ${stats.ok}, ошибок: ${stats.fail}`);
  if ($('ytd-continuation-item-renderer')) {
    console.log('ℹ️ YouTube ещё не догрузил всё: нажмите F5 и запустите скрипт ещё раз — счёт продолжится с того же места.');
  } else {
    sessionStorage.removeItem('unsub_stats');
    console.log('ℹ️ Подгрузок больше нет — список подписок очищен полностью.');
  }
})();
