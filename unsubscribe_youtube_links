(async function ultimateUnsubscribeV3() {
  console.log('🚀 МАССОВАЯ ОТПИСКА v3 (фикс полок ytd-shelf-renderer и подгрузки)');

  const PAUSE_BETWEEN = 1500;
  const MAX_EMPTY_ROUNDS = 5;

  const sleep = ms => new Promise(r => setTimeout(r, ms));

  // ОДИН клик
  function click(el, desc = '') {
    if (!el) return;
    el.scrollIntoView({ block: 'center' });
    el.click();
    if (desc) console.log('   🖱️ ' + desc);
  }

  function waitFor(selector, timeout = 6000) {
    return new Promise(res => {
      const t0 = Date.now();
      (function chk() {
        const el = document.querySelector(selector);
        if (el || Date.now() - t0 > timeout) res(el);
        else setTimeout(chk, 250);
      })();
    });
  }

  // Находим каналы и предварительно зачищаем пустые полки
  function getSubscribed() {
    // Находим все полки и удаляем те, где уже нет каналов
    document.querySelectorAll('ytd-shelf-renderer').forEach(shelf => {
      if (!shelf.querySelector('ytd-channel-renderer')) {
        shelf.remove();
      }
    });

    return [...document.querySelectorAll('ytd-channel-renderer')].filter(ch => {
      const btn = ch.querySelector('ytd-subscribe-button-renderer');
      if (!btn) return false;
      const txt = btn.textContent || '';
      return btn.hasAttribute('subscribed') ||
             txt.includes('Вы подписаны') || txt.includes('Subscribed');
    });
  }

  function name(ch) {
    const a = ch.querySelector('#channel-name a, ytd-channel-name a, a[href*="/@"]');
    return a ? a.textContent.trim() : 'канал';
  }

  async function unsubOne(ch) {
    console.log('🔹 ' + name(ch));
    const btn = ch.querySelector('ytd-subscribe-button-renderer button');
    if (!btn) return false;

    click(btn, '«Вы подписаны»');
    await sleep(700);

    let dialog = await waitFor('yt-confirm-dialog-renderer', 3500);
    if (!dialog) {
      const menu = await waitFor('tp-yt-paper-listbox, ytd-menu-popup-renderer', 2500);
      if (menu) {
        for (const it of menu.querySelectorAll('[role="menuitem"], ytd-menu-service-item-renderer, tp-yt-paper-item')) {
          if (/Отписаться|Unsubscribe/i.test(it.textContent)) { click(it, '«Отписаться»'); break; }
        }
        await sleep(700);
        dialog = await waitFor('yt-confirm-dialog-renderer', 3500);
      }
    }
    if (!dialog) { console.log('   ❌ нет диалога'); return false; }

    const confirmBtn = [...dialog.querySelectorAll('button')]
      .find(b => /Отказаться|Отписаться|Unsubscribe/i.test(b.textContent + (b.getAttribute('aria-label') || '')))
      || dialog.querySelector('#confirm-button button, #confirm-button');
    if (!confirmBtn) { console.log('   ❌ нет кнопки подтверждения'); return false; }

    click(confirmBtn, 'подтверждение');
    await sleep(900);
    console.log('   ✅ отписан');
    return true;
  }

  // Жёсткая подгрузка с учетом очистки пустых полок
  async function forceLoadMore() {
    const content = document.querySelector('#content');
    const before = document.querySelectorAll('ytd-channel-renderer').length;
    for (let i = 0; i < 6; i++) {
      const h = document.body.scrollHeight;
      window.scrollTo(0, h);
      if (content) content.scrollTo(0, h);
      window.dispatchEvent(new Event('scroll'));
      document.dispatchEvent(new Event('scroll'));
      await sleep(1200);
      if (document.querySelectorAll('ytd-channel-renderer').length > before) break;
    }
    await sleep(800);
  }

  // ---------- основной цикл ----------
  let ok = 0, fail = 0, empty = 0, round = 0;

  while (empty < MAX_EMPTY_ROUNDS) {
    round++;
    const list = getSubscribed();
    console.log(`📊 Раунд ${round}: подписок в DOM: ${list.length}`);

    if (!list.length) {
      empty++;
      console.log(`   ⏳ не найдено, подгружаю (${empty}/${MAX_EMPTY_ROUNDS})...`);
      await forceLoadMore();
      continue;
    }
    empty = 0;

    for (const ch of list) {
      // Сохраняем ссылку на родительскую полку перед удалением канала
      const parentShelf = ch.closest('ytd-shelf-renderer');
      
      if (await unsubOne(ch)) ok++; else fail++;
      
      // Удаляем сам канал
      ch.remove();
      
      // Если полка осталась пустой — удаляем и её, чтобы не ломать скролл
      if (parentShelf && !parentShelf.querySelector('ytd-channel-renderer')) {
        parentShelf.remove();
      }
      
      await sleep(PAUSE_BETWEEN);
    }

    console.log(`📈 Промежуточно: ✅ ${ok}, ❌ ${fail}`);
    await forceLoadMore();
  }

  console.log(`🎉 ГОТОВО! Отписано: ${ok}, ошибок: ${fail}`);
  console.log('ℹ️ Если каналы еще остались, обновите страницу (F5) и запустите повторно.');
})();
