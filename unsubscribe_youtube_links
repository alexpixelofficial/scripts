(async function ultimateUnsubscribe() {
    console.log('🚀 ЗАПУСК МАССОВОЙ ОТПИСКИ (оптимизированная версия)');

    // ---------- Настройки ----------
    const PAUSE_BETWEEN_UNSUB = 1200;   // мс между отписками
    const SCROLL_WAIT = 2000;           // мс ожидания после каждой прокрутки
    const MAX_SCROLL_ATTEMPTS = 50;     // макс. прокруток (но обычно хватает)
    const MIN_CHANNELS_TO_START = 50;   // минимальное число каналов перед стартом (можно уменьшить)

    // ---------- Вспомогательные функции ----------
    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    // Ожидание появления элемента с таймаутом (проверка каждые 300 мс)
    function waitForElement(selector, timeout = 8000) {
        return new Promise((resolve) => {
            const start = Date.now();
            const check = () => {
                const el = document.querySelector(selector);
                if (el) resolve(el);
                else if (Date.now() - start > timeout) resolve(null);
                else setTimeout(check, 300);
            };
            check();
        });
    }

    // Простой надёжный клик (без двойных событий)
    function clickElement(element, description = '') {
        if (!element) return;
        element.scrollIntoView({ block: 'center' });
        // Небольшая задержка перед кликом, чтобы элемент точно стал видимым
        setTimeout(() => {
            element.click();
            // Дополнительно посылаем событие click (на случай, если обычный не сработал)
            element.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
        }, 200);
        if (description) console.log(`   🖱️ ${description}`);
    }

    // Получение имени канала
    function getChannelName(channel) {
        const selectors = ['#channel-name a', '#text-container a', 'ytd-channel-name a', 'a#channel-name'];
        for (const sel of selectors) {
            const el = channel.querySelector(sel);
            if (el) {
                const text = el.textContent.trim();
                if (text) return text;
            }
        }
        const link = channel.querySelector('a[href*="/@"]');
        if (link && link.getAttribute('aria-label')) {
            const aria = link.getAttribute('aria-label');
            const match = aria.match(/канал\s+(.+?)(?:$|,)/i);
            if (match) return match[1].trim();
        }
        return 'Неизвестный канал';
    }

    // ---------- Функция отписки от одного канала ----------
    async function unsubscribeOne(channel) {
        const name = getChannelName(channel);
        console.log(`\n🔹 ${name}`);

        // 1. Найти кнопку "Подписан"
        const subBtn = channel.querySelector('ytd-subscribe-button-renderer[subscribed] button');
        if (!subBtn) {
            console.log('   ⏭️ нет кнопки подписки');
            return false;
        }

        // 2. Клик по кнопке (простой)
        clickElement(subBtn, 'кнопка "Подписан"');
        await sleep(800); // даём время на появление диалога/меню

        // 3. Ожидаем диалог
        let dialog = await waitForElement('yt-confirm-dialog-renderer', 6000);
        if (!dialog) {
            // Если диалог не появился, пробуем меню
            console.log('   ⏳ диалог не появился, ищем меню...');
            const menu = await waitForElement('tp-yt-paper-listbox, paper-menu, ytd-menu-popup-renderer', 4000);
            if (menu) {
                const items = menu.querySelectorAll('ytd-menu-service-item-renderer, paper-item, tp-yt-paper-item, div[role="menuitem"]');
                let found = false;
                for (const item of items) {
                    const text = item.textContent.trim();
                    if (text.includes('Отписаться') || text.includes('Unsubscribe')) {
                        clickElement(item, 'пункт "Отписаться"');
                        found = true;
                        break;
                    }
                }
                if (found) {
                    await sleep(800);
                    dialog = await waitForElement('yt-confirm-dialog-renderer', 6000);
                    if (!dialog) {
                        console.log('   ❌ диалог после меню не появился');
                        return false;
                    }
                } else {
                    console.log('   ❌ пункт "Отписаться" не найден');
                    return false;
                }
            } else {
                console.log('   ❌ ни диалог, ни меню не найдены');
                return false;
            }
        }

        // 4. Найти синюю кнопку подтверждения
        console.log('   🔍 ищем кнопку подтверждения...');
        let confirmBtn = null;
        // Ищем по aria-label или тексту
        const allButtons = dialog.querySelectorAll('button');
        for (const btn of allButtons) {
            const aria = btn.getAttribute('aria-label') || '';
            const text = btn.textContent.trim();
            if (aria.includes('Отказаться от подписки') || aria.includes('Unsubscribe') ||
                text.includes('Отказаться от подписки') || text.includes('Unsubscribe')) {
                confirmBtn = btn;
                break;
            }
        }
        // Если не нашли, пробуем #confirm-button
        if (!confirmBtn) {
            const wrapper = dialog.querySelector('#confirm-button');
            if (wrapper) {
                confirmBtn = wrapper.querySelector('button') || wrapper;
            }
        }
        if (!confirmBtn) {
            console.log('   ❌ кнопка подтверждения не найдена');
            return false;
        }

        // 5. Клик по синей кнопке
        clickElement(confirmBtn, 'синяя кнопка "Отказаться"');
        await sleep(1000);
        console.log('   ✅ отписан');
        return true;
    }

    // ---------- Функция бесконечной прокрутки для загрузки ВСЕХ каналов ----------
    async function scrollToLoadAllChannels() {
        console.log('🔄 Начинаем загрузку всех подписок (может занять время)...');
        let lastHeight = 0;
        let noChangeCount = 0;
        let scrollAttempts = 0;

        while (scrollAttempts < MAX_SCROLL_ATTEMPTS) {
            window.scrollTo(0, document.documentElement.scrollHeight);
            await sleep(SCROLL_WAIT);

            const newHeight = document.documentElement.scrollHeight;
            if (newHeight === lastHeight) {
                noChangeCount++;
                // Если высота не меняется несколько раз подряд, считаем, что загрузка завершена
                if (noChangeCount >= 3) {
                    console.log('📦 Высота страницы стабильна – все каналы загружены.');
                    break;
                }
            } else {
                noChangeCount = 0;
                lastHeight = newHeight;
                console.log(`🔄 Прокрутка ${scrollAttempts + 1}, загружено элементов: ${document.querySelectorAll('ytd-channel-renderer').length}`);
            }
            scrollAttempts++;
        }

        // Дополнительная пауза, чтобы точно всё отрисовалось
        await sleep(2000);
        console.log(`📊 Всего загружено каналов: ${document.querySelectorAll('ytd-channel-renderer').length}`);
        window.scrollTo(0, 0);
        await sleep(500);
    }

    // ---------- Основной процесс ----------
    // Шаг 1: Загружаем все каналы (бесконечная прокрутка)
    await scrollToLoadAllChannels();

    // Шаг 2: Собираем все подписанные каналы
    let allChannels = document.querySelectorAll('ytd-channel-renderer');
    let subscribedChannels = [];
    for (const ch of allChannels) {
        if (ch.querySelector('ytd-subscribe-button-renderer[subscribed]')) {
            subscribedChannels.push(ch);
        }
    }

    console.log(`\n📌 Найдено подписанных каналов: ${subscribedChannels.length}`);

    if (subscribedChannels.length === 0) {
        console.log('🎉 У вас нет подписок!');
        return;
    }

    // Шаг 3: Отписываемся от всех
    let successCount = 0;
    let failCount = 0;

    for (let i = 0; i < subscribedChannels.length; i++) {
        const channel = subscribedChannels[i];
        console.log(`\n--- Канал ${i + 1}/${subscribedChannels.length} ---`);
        const ok = await unsubscribeOne(channel);
        if (ok) successCount++; else failCount++;
        await sleep(PAUSE_BETWEEN_UNSUB);
    }

    // Шаг 4: Проверяем, не появились ли новые подписки (если прокрутка не догрузила)
    // (обычно после отписки они исчезают, но на всякий случай)
    const remaining = document.querySelectorAll('ytd-subscribe-button-renderer[subscribed]');
    if (remaining.length > 0) {
        console.log(`⚠️ Осталось ещё ${remaining.length} подписанных каналов. Возможно, они не прогрузились ранее.`);
        console.log('🔄 Запускаем повторную прокрутку и отписку...');
        // Можно рекурсивно вызвать, но для простоты просто предложим запустить скрипт ещё раз.
        console.log('👉 Если хотите, запустите скрипт снова или обновите страницу.');
    }

    console.log(`\n📊 ИТОГ: успешно отписано ${successCount}, ошибок ${failCount}`);
    console.log('✅ СКРИПТ ЗАВЕРШЁН.');
})();
